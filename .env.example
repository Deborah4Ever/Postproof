# Database Configuration (PostgreSQL on Railway or SQLite locally)
DATABASE_URL=sqlite:///./data/personal_agent.db
# DATABASE_URL=postgresql://user:password@host:port/database

# Optional Redis URL (for future distributed queues or caching)
REDIS_URL=redis://localhost:6379

# External APIs
MONID_API_KEY=your-monid-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
LLM_API_KEY=your-anthropic-api-key

# Security & Sessions
AUTH_SECRET=generate-a-secure-random-secret-key-for-sessions

# Background Worker Settings
DISABLE_BACKGROUND_SCANNER=0

# Receipts & Storage
RECEIPTS_PATH=receipts/ledger.jsonl
UPLOADS_DIR=uploads
